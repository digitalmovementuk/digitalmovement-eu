{
  "name": "digital-movement-de",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite-react-ssg build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "vite preview",
    "check:render": "node scripts/check-render.mjs",
    "deploy": "npm run build && node scripts/check-render.mjs && node scripts/publish.mjs",
    "deploy:draft": "npm run build && node scripts/check-render.mjs && node scripts/publish-draft.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-react-ssg": "^0.9.2"
  }
}
