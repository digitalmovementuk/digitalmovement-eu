# Wohin Anfragen gehen.
#
# HIER STEHT NICHTS GEHEIMES. Die Seite ist statisch, jeder Wert von hier
# landet im JavaScript, das an den Browser ausgeliefert wird, und ist dort
# lesbar. Niemals ein Passwort oder einen privaten Token hier ablegen.

# Der eigene PHP-Endpunkt, geteilt mit digitalmovement.uk. Adresse ist die
# Wurzel der Subdomain — /send.php gibt es nicht und liefert 404. Der Origin
# muss auf der Freigabeliste des Endpunkts stehen, und die Anfrage muss
# `consent` mitschicken, sonst wird sie abgelehnt.
VITE_DM_LEAD_ENDPOINT=https://leads.digitalmovement.uk/

# Nicht in Gebrauch.
VITE_WEB3FORMS_KEYS=
VITE_LEAD_ENDPOINT=

# GA4 — die deutsche Property, seit 24.08.2026.
#
# G-R5ZFKGZKCZ gehoert zur Property "Digital Movement Germany"
# (properties/551277672, Datenstream 15493627050, Zeitzone Europe/Berlin,
# Waehrung EUR, Aufbewahrung 14 Monate). Vorher stand hier die Mess-ID der
# neuseeländischen Property — die deutsche Seite darf nicht in ein fremdes
# Konto messen.
#
# Die ID ist oeffentlich; sie steht in jedem ausgelieferten Skript. Das ist
# kein Geheimnis und keine Zugangsberechtigung.
#
# WICHTIG: Das Tag wird NICHT beim Seitenaufruf geladen. § 25 TDDDG verlangt
# eine Einwilligung, bevor etwas auf dem Endgeraet gespeichert oder gelesen
# wird. gtag.js laedt deshalb erst, wenn die Besucherin im Banner zustimmt —
# siehe src/lib/analytics.ts und src/components/CookieBanner.tsx.
# In .env steht hier die echte Mess-ID der Property
# "Digital Movement Germany". Diese Vorlagendatei bleibt leer.
VITE_GA4_ID=
